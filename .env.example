EHBOT_PORT=8080
EHBOT_UID=1000
EHBOT_GID=1000
# Optional. Leave unset and the application generates and persists a
# session key under <data>/private on first start. Set it only when
# several replicas must share one key.
# APP_SECRET_KEY=
DATA_PATH=/app/data
LIBRARY_PATH=/library
WORK_PATH=/work
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
APP_ROOT_PATH=
TAG_TRANSLATION_ENABLED=true
ARCHIVE_TOOLCHAIN_AUTO_INSTALL=true
TELEGRAPH_ENABLED=true
# Initial value only. Once set in Settings -> System it is stored in the
# database and this is ignored; the polling cadence and display timezone
# live there too and have no environment variable at all.
TELEGRAPH_CONCURRENCY=3
TELEGRAPH_MAX_IMAGES=400
TELEGRAPH_MAX_IMAGE_BYTES=20971520
TELEGRAPH_MAX_TOTAL_BYTES=1073741824
TELEGRAPH_TIMEOUT_SECONDS=600
TELEGRAPH_REQUIRE_FILECOUNT_MATCH=true
TORRENT_ENABLED=true
TORRENT_POLL_SECONDS=15
TORRENT_CATEGORY=ehbot
TORRENT_KEEP_SEEDING=true
# Serve candidate covers through the local thumbnail proxy. Off means the
# review list renders placeholders and nothing is fetched from the image host.
THUMBNAILS_ENABLED=true
TZ=Asia/Shanghai
# Logging. Deployment-level, so unlike the polling cadence and timezone these
# are environment variables and not database settings: a log level stored in
# the database cannot help you debug a startup that failed before it opened.
LOG_LEVEL=INFO
# Access log for every HTTP request. Off removes the noise a foreground tab's
# polling generates; error and application logs are unaffected.
LOG_ACCESS=true
# Retain a rotating JSON log under <data>/logs in addition to stdout. The
# container's stdout is capped by the Docker log driver, which does not keep
# history across a container rebuild; this does.
LOG_TO_FILE=true
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUPS=5
